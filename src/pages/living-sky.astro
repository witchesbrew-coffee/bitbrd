    });
    setTimeout(function(){
      idx.forEach(function(di,k){band.querySelector('#wbsprN'+k).textContent=DECK[di][1];band.querySelector('#wbsprT'+k).innerHTML='&ldquo;'+DECK[di][3]+'&rdquo;';});
      band.querySelector('#wbsprReads').classList.add('wbspr-show');
      var present=DECK[idx[1]];var pour=band.querySelector('#wbsprPour');
      band.querySelector('#wbsprPourD').innerHTML=present[4];pour.setAttribute('href',drinkLink(present[5]));pour.classList.add('wbspr-show');
      band.querySelector('#wbsprAgain').classList.remove('wbspr-hide');
    },120+2*230+780+700);
  }
  function reset(){band.querySelector('#wbsprReads').classList.remove('wbspr-show');band.querySelector('#wbsprPour').classList.remove('wbspr-show');band.querySelector('#wbsprAgain').classList.add('wbspr-hide');['wbsprN0','wbsprN1','wbsprN2','wbsprT0','wbsprT1','wbsprT2'].forEach(function(id){band.querySelector('#'+id).textContent='';});layoutFan();}
  function run(){band.querySelector('#wbsprConsult').classList.add('wbspr-hide');collect();setTimeout(function(){shuffle(function(){deal(pick3());});},650);}
  band.querySelector('#wbsprConsult').addEventListener('click',run);
  band.querySelector('#wbsprAgain').addEventListener('click',function(){reset();setTimeout(function(){collect();setTimeout(function(){shuffle(function(){deal(pick3());});},500);},40);});
  DECK.forEach(function(x){var im=new Image();im.src=art(x[2]);});
  (function(){var b=new Image();b.src=ARCH;})();
  layoutFan();
})();
</script>
