---
import Skyline from '../components/Skyline.astro';
const siteUrl = 'https://bitbrd.com';
const title = 'BitBrd | Tech Bundle for Independent Restaurants & Retail';
const description = 'Websites, local SEO, modern phone systems, and custom dashboards for independent restaurants and small-batch retail. One team. Owner-operator pricing.';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BitBrd',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  description,
  areaServed: 'United States',
  knowsAbout: [
    'Website design',
    'Local SEO',
    'VOIP phone systems',
    'Business dashboards',
    'Small business marketing',
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does it cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Get online for $100 to launch plus $20/month hosting: a clean one-page site, designed for you. Our most popular package is $400 to design plus $60/month: more pages, a stronger design, and local SEO built in. Bigger builds like online stores, phone systems, and custom dashboards are quoted up front, custom.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you really replace my phone system?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. For most small operators, we cut the phone bill in half or better. Modern VOIP handles everything legacy PBX does plus voicemail-to-email, SMS from your business number, and mobile softphone. We port your existing number so customers never notice the switch.',
      },
    },
    {
      '@type': 'Question',
      name: 'What does a custom dashboard actually pull in?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Whatever you use. Common integrations: Shopify, Square, Toast, DoorDash, Uber Eats, GA4, Google Search Console, QuickBooks, Homebase, and inventory systems. We build it around your business, not a template.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long until my site is live?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '1 to 2 weeks for a single-page site. 3 to 5 weeks for bigger builds. Phone system switchover is usually a 1-week window once numbers are ported.',
      },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta property="og:title" content="BitBrd | Tech Bundle for Independent Operators" />
<meta property="og:description" content="Build it. Find it. Answer it. See it. The tech stack independent restaurants and retailers actually need." />
<meta property="og:type" content="website" />
<meta property="og:url" content={siteUrl} />
<meta property="og:image" content={`${siteUrl}/og-image.png`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="BitBrd | Tech Bundle for Independent Operators" />
<meta name="twitter:description" content="Build it. Find it. Answer it. See it." />
<meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
<link rel="canonical" href={siteUrl} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" href="/favicon.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<script type="application/ld+json" set:html={JSON.stringify(orgSchema)}></script>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<!-- Google Analytics 4 -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TYHKJYCBBR"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-TYHKJYCBBR');
</script>

<style is:global>
:root{
  --navy:#0F3F7A;
  --navy-900:#082545;
  --navy-800:#0A1F3D;
  --navy-700:#0E2E55;
  --sky:#9FD4F2;
  --sky-light:#CFE9F7;
  --ink:#0A1628;
  --cream:#F7FAFD;
  --text:#E8F2FC;
  --muted:#8CA3BA;
  --accent:#4AA8DC;
  --green:#34D399;
  --border:rgba(159,212,242,0.15);
  --border-strong:rgba(159,212,242,0.35);
  --pad:104px;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Inter',system-ui,sans-serif;background:var(--ink);color:var(--text);line-height:1.6;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
::selection{background:var(--sky);color:var(--navy-900)}
:focus-visible{outline:2px solid var(--sky);outline-offset:3px}
.container{max-width:1200px;margin:0 auto;padding:0 24px}
.pixel{font-family:'Press Start 2P',monospace;letter-spacing:0.02em;line-height:1.4}
.eyebrow{font-family:'Press Start 2P',monospace;font-size:10px;color:var(--sky);letter-spacing:0.15em;text-transform:uppercase;margin-bottom:1.25rem;display:inline-flex;align-items:center;gap:10px}
.eyebrow::before{content:'';width:10px;height:10px;background:var(--sky);flex:none}
.btn{display:inline-flex;align-items:center;gap:8px;padding:15px 26px;font-family:'Inter',sans-serif;font-weight:600;font-size:0.95rem;border-radius:4px;transition:background 0.2s,transform 0.2s,border-color 0.2s,box-shadow 0.2s;border:none;cursor:pointer}
.btn-primary{background:var(--sky);color:var(--navy-900);box-shadow:0 8px 24px rgba(74,168,220,0.22)}
.btn-primary:hover{background:var(--sky-light);transform:translateY(-1px)}
.btn-ghost{background:transparent;color:var(--sky);border:1px solid var(--border-strong)}
.btn-ghost:hover{background:rgba(159,212,242,0.05);border-color:var(--sky)}

/* NAV */
.nav{position:sticky;top:0;z-index:100;background:rgba(10,22,40,0.86);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
.nav-inner{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;max-width:1200px;margin:0 auto}
.nav-logo{height:36px;width:auto}
.nav-menu{display:flex;gap:30px;align-items:center}
.nav-menu a:not(.btn){font-size:0.9rem;color:var(--muted);transition:color 0.2s;padding:6px 0;border-bottom:2px solid transparent}
.nav-menu a:not(.btn):hover{color:var(--text);border-bottom-color:var(--sky)}
.nav-menu .btn{padding:10px 20px;font-size:0.85rem;box-shadow:none}
.nav-burger{display:none;background:none;border:1px solid var(--border-strong);border-radius:4px;width:42px;height:38px;cursor:pointer;flex-direction:column;align-items:center;justify-content:center;gap:5px}
.nav-burger span{display:block;width:18px;height:2px;background:var(--sky);transition:transform 0.25s,opacity 0.25s}
.nav-drawer{display:none;border-top:1px solid var(--border);background:var(--navy-900)}
.nav-drawer a{display:block;padding:16px 24px;border-bottom:1px solid var(--border);font-family:'Press Start 2P',monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:var(--sky)}
.nav-drawer a:last-child{border-bottom:none;color:var(--navy-900);background:var(--sky);text-align:center}
.nav.open .nav-drawer{display:block}
.nav.open .nav-burger span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav.open .nav-burger span:nth-child(2){opacity:0}
.nav.open .nav-burger span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

/* HERO */
.hero{position:relative;overflow:hidden;padding:110px 0 90px;background:var(--ink)}
.hero::before{content:'';position:absolute;inset:0;background:
  radial-gradient(ellipse at 80% 20%,rgba(15,63,122,0.55),transparent 55%),
  radial-gradient(ellipse at 10% 90%,rgba(74,168,220,0.14),transparent 50%)}
.hero-stars{position:absolute;inset:0;pointer-events:none}
.hero-stars i{position:absolute;width:3px;height:3px;background:var(--sky);opacity:0.35;animation:starTw 6s steps(1) infinite}
.hero-stars i:nth-child(odd){animation-duration:9s;animation-delay:-3s}
.hero-stars i:nth-child(3n){width:2px;height:2px;animation-delay:-5s}
@keyframes starTw{0%,45%{opacity:0.35}46%,60%{opacity:0.08}61%,100%{opacity:0.35}}
@media (prefers-reduced-motion:reduce){.hero-stars i{animation:none}}
.hero-grid{position:relative;display:grid;grid-template-columns:1.15fr 0.85fr;gap:56px;align-items:center}
.hero h1{font-family:'Press Start 2P',monospace;font-size:clamp(1.7rem,4.1vw,3rem);line-height:1.35;color:var(--cream);margin-bottom:1.6rem;letter-spacing:-0.01em}
.hero h1 span{color:var(--sky)}
.hero-sub{font-size:1.18rem;line-height:1.7;color:var(--muted);margin-bottom:2.2rem;max-width:560px}
.hero-ctas{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:2.4rem}
.hero-facts{display:flex;align-items:center;padding-top:1.4rem;border-top:1px solid var(--border);max-width:640px}
.hero-facts div{display:flex;align-items:center;gap:10px;font-size:0.86rem;color:var(--muted);white-space:nowrap;padding:0 22px;border-left:1px solid var(--border);line-height:1}
.hero-facts div:first-child{padding-left:0;border-left:none}
.hero-facts b{font-family:'Press Start 2P',monospace;font-size:0.78rem;color:var(--sky)}
.hero-mascot-wrap{position:relative}
.hero-mascot{width:100%;max-width:470px;margin-left:auto;filter:drop-shadow(0 24px 48px rgba(74,168,220,0.28));animation:mascotHover 6s ease-in-out infinite}
@keyframes mascotHover{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
@media (prefers-reduced-motion:reduce){.hero-mascot{animation:none}}

/* PROOF STRIP */
.proof{background:var(--navy-900);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.proof-inner{display:grid;grid-template-columns:auto 1fr 1fr 1fr;align-items:center;gap:40px;padding:26px 24px;max-width:1200px;margin:0 auto}
.proof-label{font-family:'Press Start 2P',monospace;font-size:9px;color:var(--sky);letter-spacing:0.2em;text-transform:uppercase;line-height:1.7;max-width:150px}
.proof-logo{min-height:50px;display:flex;align-items:center;justify-content:center;color:var(--muted);opacity:0.8;transition:opacity 0.2s,color 0.2s;text-align:center;padding:4px 12px}
.proof-logo:hover{opacity:1;color:var(--text)}
.proof-img{height:64px;width:auto;opacity:0.92}
.proof-mark{flex-direction:column;gap:2px;line-height:1.1}
.proof-mark span{display:block;font-size:0.6rem;font-weight:600;letter-spacing:0.28em;text-transform:uppercase;color:var(--muted);margin-top:5px}
.proof-mark--dta{font-family:Georgia,'Times New Roman',serif;font-size:1.3rem;font-weight:600;color:var(--cream)}
.proof-mark--wlrg{font-family:'Inter',sans-serif;font-weight:700;font-size:1.1rem;color:var(--cream)}

/* SECTION HEADERS */
.section-header{max-width:760px;margin:0 0 3.5rem}
.section-header--center{text-align:center;margin-inline:auto}
.section-header--center .eyebrow{justify-content:center}
.section-header h2{font-family:'Press Start 2P',monospace;font-size:clamp(1.3rem,2.7vw,2.05rem);line-height:1.45;color:var(--cream);margin-bottom:1.1rem}
.section-header p{font-size:1.08rem;color:var(--muted);line-height:1.7}
.section-header a{color:var(--sky);border-bottom:1px dotted rgba(159,212,242,0.4)}
.section-header a:hover{color:var(--sky-light)}

/* WORK WALL */
.work{padding:var(--pad) 0;background:var(--ink)}
.work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.work-frame{display:block;background:var(--navy-900);border:1px solid var(--border);border-radius:8px;overflow:hidden;transition:transform 0.25s,box-shadow 0.25s,border-color 0.25s;container-type:inline-size}
.work-frame:hover{transform:translateY(-4px);box-shadow:0 18px 44px rgba(74,168,220,0.18);border-color:var(--sky)}
.work-bar{display:flex;gap:6px;padding:10px 12px;border-bottom:1px solid var(--border)}
.work-bar i{width:8px;height:8px;border-radius:50%;background:var(--navy-700)}
.work-bar i:first-child{background:var(--accent)}
.work-scroll{display:block;aspect-ratio:3/4;overflow:hidden}
.work-scroll img{width:100%;height:auto;display:block;animation:workScroll 36s ease-in-out infinite alternate}
.work-frame:hover .work-scroll img{animation-play-state:paused}
@keyframes workScroll{0%,3%{transform:translateY(0)}97%,100%{transform:translateY(calc(-100% + 133.4cqw))}}
@media (prefers-reduced-motion:reduce){.work-scroll img{animation:none}}
.work-cap{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 16px;border-top:1px solid var(--border);font-weight:600;color:var(--cream);font-size:0.95rem}
.work-cap span{display:block;font-size:0.78rem;color:var(--muted);font-weight:500;margin-top:2px}
.work-cap em{font-style:normal;font-family:'Press Start 2P',monospace;font-size:8px;color:var(--green);letter-spacing:0.1em;white-space:nowrap}

/* RECEIPTS */
.receipts{margin-top:72px;border:1px solid var(--border-strong);border-radius:10px;background:var(--navy-900);overflow:hidden}
.receipts-head{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px 28px;border-bottom:1px solid var(--border)}
.receipts-label{font-family:'Press Start 2P',monospace;font-size:10px;color:var(--sky);letter-spacing:0.2em;text-transform:uppercase;line-height:1.7}
.receipts-note{font-size:0.85rem;color:var(--muted)}
.receipts-grid{display:grid;grid-template-columns:repeat(3,1fr)}
.receipt{padding:28px;border-right:1px solid var(--border)}
.receipt:last-child{border-right:none}
.g-them{transform-box:fill-box;transform-origin:50% 100%;animation:gSputter 3.6s infinite}
@keyframes gSputter{0%,12%{transform:rotate(-80deg)}40%{transform:rotate(-28deg)}48%{transform:rotate(-38deg)}56%{transform:rotate(-25deg)}64%{transform:rotate(-35deg)}85%{transform:rotate(-30deg)}100%{transform:rotate(-80deg)}}
.g-us{transform-box:fill-box;transform-origin:50% 100%;animation:gRev 3.6s cubic-bezier(0.4,0,0.3,1.3) infinite}
@keyframes gRev{0%,12%{transform:rotate(-80deg)}42%,85%{transform:rotate(76deg)}100%{transform:rotate(-80deg)}}
@media (prefers-reduced-motion:reduce){.g-them,.g-us{animation:none}.g-us{transform:rotate(76deg)}.g-them{transform:rotate(-30deg)}}
.rk-marker{animation:rkLadder 4.5s cubic-bezier(0.22,1,0.36,1) infinite}
@keyframes rkLadder{0%,12%{transform:translateY(0)}30%{transform:translateY(-22px)}50%{transform:translateY(-44px)}70%,88%{transform:translateY(-66px)}100%{transform:translateY(0)}}
@media (prefers-reduced-motion:reduce){.rk-marker{animation:none;transform:translateY(-66px)}}
.receipt-chart{margin-bottom:14px}
.vs-row{margin-bottom:14px}
.vs-label{display:block;font-size:0.78rem;color:var(--muted);margin-bottom:5px}
.vs-label--us{color:var(--sky-light);font-weight:600}
.vs-track{position:relative;display:flex;align-items:center;gap:10px;height:18px}
.vs-bar{height:18px;border-radius:3px;width:var(--w);transform:scaleX(0);transform-origin:left;transition:transform 1.1s cubic-bezier(0.22,1,0.36,1)}
.vs-bar--them{background:linear-gradient(90deg,#8E4A4A,#B85F5F)}
.vs-bar--us{background:linear-gradient(90deg,var(--accent),var(--sky));box-shadow:0 0 14px rgba(74,168,220,0.5);transition-delay:0.35s}
.vs-val{font-size:0.85rem;font-weight:700;color:var(--text);opacity:0;transition:opacity 0.6s ease 0.9s;white-space:nowrap}
.vs-val--us{color:var(--sky-light)}
.receipt.in-view .vs-bar{transform:scaleX(1)}
.receipt.in-view .vs-val{opacity:1}
@media (prefers-reduced-motion:reduce){.vs-bar{transform:scaleX(1);transition:none}.vs-val{opacity:1;transition:none}}
.receipt-title{font-family:'Press Start 2P',monospace;font-size:9px;color:var(--sky);letter-spacing:0.05em;text-transform:uppercase;margin-bottom:8px;line-height:1.6}
.receipt p{color:var(--muted);font-size:0.9rem;line-height:1.65}
.receipt b{color:var(--text)}

/* PROBLEM LEDGER */
.problem{padding:var(--pad) 0;background:var(--navy-900);border-top:1px solid var(--border)}
.problem-ledger{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--ink)}
.problem-card{padding:34px 30px 36px;border-right:1px solid var(--border);opacity:0;transform:translateY(24px);transition:opacity 0.7s cubic-bezier(0.22,1,0.36,1),transform 0.7s cubic-bezier(0.22,1,0.36,1)}
.problem-card:last-child{border-right:none}
.problem.in-view .problem-card:nth-child(1){opacity:1;transform:none;transition-delay:0.1s}
.problem.in-view .problem-card:nth-child(2){opacity:1;transform:none;transition-delay:0.3s}
.problem.in-view .problem-card:nth-child(3){opacity:1;transform:none;transition-delay:0.5s}
.problem-card-num{font-family:'Press Start 2P',monospace;font-size:12px;color:var(--sky);margin-bottom:1.2rem;display:flex;align-items:center;gap:12px}
.problem-card-num::after{content:'';flex:1;height:1px;background:var(--border)}
.problem-viz{height:74px;background:var(--navy-800);border-radius:6px;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:1.2rem}
.problem-viz svg{width:220px;height:70px;display:block}
.pb-coin{animation:pbFall 2.2s linear infinite;opacity:0}
@keyframes pbFall{0%{transform:translateY(-8px);opacity:0}12%{opacity:1}85%{opacity:1}100%{transform:translateY(58px);opacity:0}}
.pb-pane{transform-box:fill-box;transform-origin:50% 50%}
.pb-j1{animation:pbJit 2.8s infinite}.pb-j2{animation:pbJit 2.8s 0.4s infinite}.pb-j3{animation:pbJit 2.8s 0.9s infinite}.pb-j4{animation:pbJit 2.8s 1.3s infinite}
@keyframes pbJit{0%,88%{transform:rotate(0)}90%{transform:rotate(-2.5deg) translateY(1px)}93%{transform:rotate(2deg)}96%{transform:rotate(-1deg)}100%{transform:rotate(0)}}
.pb-warn{animation:pbBlink 1.4s steps(1) infinite}
@keyframes pbBlink{0%,49%{opacity:1}50%,100%{opacity:0.15}}
.pb-tick text{opacity:0;animation:pbTk 3.6s steps(1) infinite}
.pb-tick text:nth-child(2){animation-delay:0.9s}.pb-tick text:nth-child(3){animation-delay:1.8s;animation-name:pbTkHold}
@keyframes pbTk{0%{opacity:1}25%{opacity:0}100%{opacity:0}}
@keyframes pbTkHold{0%,49%{opacity:1}50%,100%{opacity:0}}
.pb-stamp{opacity:0;transform-box:fill-box;transform-origin:50% 50%;animation:pbStamp 3.6s infinite}
@keyframes pbStamp{0%,55%{opacity:0;transform:scale(1.8) rotate(-6deg)}63%{opacity:1;transform:scale(1) rotate(-6deg)}92%,100%{opacity:1;transform:scale(1) rotate(-6deg)}}
@media (prefers-reduced-motion:reduce){.pb-coin,.pb-pane,.pb-warn,.pb-tick text,.pb-stamp{animation:none}.pb-coin{opacity:0}.pb-tick text:nth-child(3){opacity:1}.pb-stamp{opacity:1;transform:rotate(-6deg)}}
.problem-card h3{font-size:1.12rem;font-weight:600;color:var(--cream);margin-bottom:0.7rem}
.problem-card p{color:var(--muted);font-size:0.95rem;line-height:1.7}
.problem-super{display:flex;align-items:center;gap:28px;margin-top:24px;padding:34px 36px;background:linear-gradient(135deg,rgba(74,168,220,0.16),rgba(15,63,122,0.4));border:1.5px solid var(--sky);border-radius:10px;box-shadow:0 18px 50px rgba(74,168,220,0.18);opacity:0;transform:translateY(24px);transition:opacity 0.7s cubic-bezier(0.22,1,0.36,1) 0.8s,transform 0.7s cubic-bezier(0.22,1,0.36,1) 0.8s}
.problem.in-view .problem-super{opacity:1;transform:none}
.problem-super-num{font-family:'Press Start 2P',monospace;font-size:1.6rem;color:var(--sky);text-shadow:0 0 16px rgba(74,168,220,0.7);flex:none}
.problem-super h3{font-family:'Press Start 2P',monospace;font-size:1rem;color:var(--cream);margin-bottom:0.6rem;line-height:1.5;display:inline-block;overflow:hidden;white-space:nowrap;border-right:8px solid transparent}
.problem.in-view .problem-super h3{animation:superTypeLoop 9s steps(20) 1.9s infinite backwards,superCaret 0.85s step-end infinite}
@keyframes superTypeLoop{0%{width:0}18%{width:20ch}88%{width:20ch}94%,100%{width:0}}
@keyframes superCaret{0%,49%{border-right-color:var(--sky)}50%,100%{border-right-color:transparent}}
@media (prefers-reduced-motion:reduce){.problem-super h3{animation:none!important;width:auto!important}.problem-card,.problem-super{opacity:1;transform:none;transition:none}}
.problem-super p{color:var(--text);font-size:0.97rem;line-height:1.7;max-width:62ch}
.problem-super-cta{flex:none;white-space:nowrap}

/* SERVICES: alternating feature rows */
.services{padding:var(--pad) 0;background:var(--ink);border-top:1px solid var(--border)}
.service-row{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center;padding:56px 0;border-top:1px solid var(--border)}
.service-row:last-child{border-bottom:1px solid var(--border)}
.service-row:nth-child(even) .service-viz{order:2}
.service-viz{background:linear-gradient(160deg,var(--navy-800),var(--navy-900));border:1px solid var(--border);border-radius:10px;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative}
.service-viz svg{width:82%;height:auto;max-height:80%;display:block}
.service-viz::after{content:attr(data-tag);position:absolute;top:14px;left:16px;font-family:'Press Start 2P',monospace;font-size:8px;letter-spacing:0.15em;color:var(--sky);opacity:0.8}
.sv-sk{opacity:0;animation:svSkin 4s infinite}
@keyframes svSkin{0%{opacity:0;transform:translateX(-12px)}12%{opacity:1;transform:none}78%{opacity:1}92%,100%{opacity:0}}
.sv-you{animation:svClimb 4.4s cubic-bezier(0.22,1,0.36,1) infinite}
@keyframes svClimb{0%,18%{transform:translateY(0)}38%,80%{transform:translateY(-40px)}100%{transform:translateY(0)}}
.sv-oth{animation:svDown 4.4s cubic-bezier(0.22,1,0.36,1) infinite}
@keyframes svDown{0%,18%{transform:translateY(0)}38%,80%{transform:translateY(20px)}100%{transform:translateY(0)}}
.sv-ring{transform-box:fill-box;transform-origin:50% 50%;animation:svShake 1.6s infinite}
@keyframes svShake{0%,8%{transform:rotate(0)}10%{transform:rotate(-14deg)}14%{transform:rotate(12deg)}18%{transform:rotate(-9deg)}22%{transform:rotate(6deg)}26%{transform:rotate(0)}100%{transform:rotate(0)}}
.sv-wave{transform-box:fill-box;transform-origin:50% 50%;animation:svWv 1.6s ease-out infinite;opacity:0}
@keyframes svWv{0%{transform:scale(0.4);opacity:0.8}70%{transform:scale(1.5);opacity:0}100%{opacity:0}}
.sv-dbar{transform-box:fill-box;transform-origin:50% 100%;animation:svDRise 3.2s cubic-bezier(0.22,1,0.36,1) infinite}
@keyframes svDRise{0%{transform:scaleY(0.15)}30%{transform:scaleY(1)}75%{transform:scaleY(1)}100%{transform:scaleY(0.15)}}
@media (prefers-reduced-motion:reduce){.sv-sk,.sv-you,.sv-oth,.sv-ring,.sv-wave,.sv-dbar{animation:none}.sv-sk{opacity:1}}
.service-kicker{font-family:'Press Start 2P',monospace;font-size:11px;color:var(--sky);letter-spacing:0.12em;text-transform:uppercase;margin-bottom:1rem;display:block}
.service-row h3{font-size:1.6rem;font-weight:700;color:var(--cream);margin-bottom:0.9rem;line-height:1.25;letter-spacing:-0.01em}
.service-row p{color:var(--muted);font-size:1.02rem;line-height:1.7;margin-bottom:1.3rem;max-width:52ch}
.service-list{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:0.55rem 1.2rem}
.service-list li{font-size:0.9rem;color:var(--muted);padding-left:18px;position:relative;line-height:1.5}
.service-list li::before{content:'▸';position:absolute;left:0;color:var(--sky)}

/* PROCESS TIMELINE */
.process{padding:var(--pad) 0;background:var(--navy-900);border-top:1px solid var(--border)}
.process-timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;position:relative}
.process-timeline::before{content:'';position:absolute;left:8%;right:8%;top:32px;height:2px;background:repeating-linear-gradient(90deg,var(--border-strong) 0 8px,transparent 8px 16px)}
.process-step{text-align:center;position:relative}
.pi-egg{transform-box:fill-box;transform-origin:50% 85%;animation:piRock 2.6s infinite}
@keyframes piRock{0%,55%,100%{transform:rotate(0)}60%{transform:rotate(-9deg)}66%{transform:rotate(8deg)}72%{transform:rotate(-5deg)}78%{transform:rotate(0)}}
.pi-wrench{transform-box:fill-box;transform-origin:50% 50%;animation:piTurn 2.2s cubic-bezier(0.4,0,0.6,1) infinite}
@keyframes piTurn{0%,30%{transform:rotate(0)}55%{transform:rotate(50deg)}70%{transform:rotate(50deg)}95%,100%{transform:rotate(0)}}
.pi-rocket{transform-box:fill-box;transform-origin:50% 60%;animation:piShake 0.5s linear infinite}
@keyframes piShake{0%,100%{transform:translate(0,0)}25%{transform:translate(-0.6px,0.5px)}50%{transform:translate(0.6px,-0.4px)}75%{transform:translate(-0.4px,-0.5px)}}
.pi-sprout{transform-box:fill-box;transform-origin:50% 95%;animation:piGrow 3s ease-in-out infinite}
@keyframes piGrow{0%,15%{transform:scale(0.78)}55%,80%{transform:scale(1.04)}100%{transform:scale(0.78)}}
@media (prefers-reduced-motion:reduce){.pi-egg,.pi-wrench,.pi-rocket,.pi-sprout{animation:none}}
.process-num{display:inline-flex;align-items:center;justify-content:center;width:64px;height:64px;background:var(--ink);border:2px solid var(--sky);border-radius:8px;color:var(--sky);margin-bottom:1.4rem;position:relative}
.process-step small{display:block;font-family:'Press Start 2P',monospace;font-size:9px;color:var(--sky);letter-spacing:0.15em;margin-bottom:0.6rem}
.process-step h3{font-size:1.15rem;font-weight:600;color:var(--cream);margin-bottom:0.5rem}
.process-step p{font-size:0.92rem;color:var(--muted);line-height:1.6;max-width:26ch;margin:0 auto}

/* INDUSTRIES */
.industries{padding:var(--pad) 0;background:var(--ink);border-top:1px solid var(--border)}
.industries-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--navy-900)}
.industry-card{padding:36px 32px 40px;border-right:1px solid var(--border)}
.industry-card:last-child{border-right:none}
.niche-viz{height:84px;background:var(--ink);border-radius:6px;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:1.4rem}
.niche-viz svg{width:220px;height:70px;display:block}
.nv-belt{animation:nvBelt 5s linear infinite}
@keyframes nvBelt{0%{transform:translateX(0)}100%{transform:translateX(-124px)}}
.nv-tape{animation:nvPrint 4.5s cubic-bezier(0.3,0,0.4,1) infinite}
@keyframes nvPrint{0%,10%{transform:translateY(-42px)}60%,88%{transform:translateY(0)}97%,100%{transform:translateY(-42px)}}
.nv-total{opacity:0;animation:nvTotal 4.5s infinite}
@keyframes nvTotal{0%,58%{opacity:0}66%,88%{opacity:1}96%,100%{opacity:0}}
.nv-slot{opacity:0;animation:nvBook 5s infinite}
@keyframes nvBook{0%{opacity:0;transform:scale(0.4)}8%{opacity:1;transform:scale(1.1)}12%,82%{opacity:1;transform:scale(1)}94%,100%{opacity:0}}
.nv-full{opacity:0;animation:nvFull 5s infinite}
@keyframes nvFull{0%,60%{opacity:0;transform:scale(1.6) rotate(-8deg)}68%{opacity:1;transform:scale(1) rotate(-8deg)}88%,100%{opacity:1;transform:scale(1) rotate(-8deg)}}
.nv-tik{animation:nvTik 5s linear infinite}
@keyframes nvTik{0%{transform:translateX(0)}100%{transform:translateX(-150px)}}
@media (prefers-reduced-motion:reduce){.nv-tik,.nv-belt,.nv-tape,.nv-total,.nv-slot,.nv-full{animation:none}.nv-slot,.nv-total{opacity:1}.nv-full{opacity:1;transform:rotate(-8deg)}}
.industry-card h3{font-family:'Press Start 2P',monospace;font-size:0.95rem;color:var(--sky);margin-bottom:1rem;line-height:1.6}
.industry-card .tagline{font-size:1.02rem;color:var(--cream);margin-bottom:1.4rem;font-weight:500;line-height:1.55}
.industry-list{list-style:none;column-count:2;column-gap:24px}
.industry-list li{font-size:0.9rem;color:var(--muted);padding:5px 0 5px 16px;position:relative;break-inside:avoid}
.industry-list li::before{content:'▸';color:var(--sky);position:absolute;left:0}

/* CASE STUDY */
.case{padding:var(--pad) 0;background:var(--navy-900);border-top:1px solid var(--border)}
.case-inner{background:linear-gradient(135deg,var(--navy-800),var(--ink));border-radius:12px;border:1px solid var(--border-strong);overflow:hidden}
.case-top{display:grid;grid-template-columns:0.75fr 1.25fr;gap:40px;align-items:center;padding:40px}
.case-tag{font-family:'Press Start 2P',monospace;font-size:10px;color:var(--sky);letter-spacing:0.15em;margin-bottom:1rem;display:block;text-transform:uppercase}
.case-inner h3{font-size:1.55rem;font-weight:700;color:var(--cream);margin-bottom:1.1rem;line-height:1.25;letter-spacing:-0.01em}
.case-desc{color:var(--muted);margin-bottom:1.4rem;font-size:0.97rem;line-height:1.7;max-width:66ch}
.case-visual{background:var(--ink);border:1px solid var(--border);border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px 22px 0;text-align:center;transition:transform 0.25s,box-shadow 0.25s}
.case-visual:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(74,168,220,0.2)}
.case-visual img{max-width:66%;height:auto;margin:auto;filter:drop-shadow(0 10px 26px rgba(0,0,0,0.45))}
.case-visual-sub{font-size:0.78rem;letter-spacing:0.08em;color:var(--muted);padding:14px 12px;border-top:1px solid var(--border);width:100%;margin-top:30px}
.case-metrics{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:rgba(10,22,40,0.5)}
.case-metrics > div{padding:24px 22px;border-right:1px solid var(--border)}
.case-metrics > div:last-child{border-right:none}
.case-metric-num{font-family:'Press Start 2P',monospace;font-size:1.25rem;color:var(--sky);margin-bottom:0.55rem;white-space:nowrap}
.case-metric-label{font-size:0.8rem;color:var(--muted);line-height:1.45}
.case-charts{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:28px 40px 36px}
.case-chart{background:var(--ink);border:1px solid var(--border);border-radius:8px;padding:18px 14px 14px}
.case-chart svg{width:100%;height:auto;display:block}
.case-chart-title{font-family:'Press Start 2P',monospace;font-size:9px;color:var(--sky);letter-spacing:0.06em;margin-top:10px;text-transform:uppercase}
.bar-rise{transform:scaleY(1);transform-box:fill-box;transform-origin:50% 100%;transition:transform 0.9s cubic-bezier(0.22,1,0.36,1)}
.case-chart:not(.in-view) .bar-rise{transform:scaleY(0)}
.bar-lbl{opacity:1;transition:opacity 0.5s ease}
.case-chart:not(.in-view) .bar-lbl{opacity:0}
.case-chart-cap{font-size:0.8rem;color:var(--muted);margin-top:6px;line-height:1.5}

/* BUILDER */
.builder{padding:var(--pad) 0;background:var(--ink);border-top:1px solid var(--border)}
.builder-inner{display:grid;grid-template-columns:0.9fr 1.1fr;gap:60px;align-items:center;max-width:1040px;margin:0 auto}
.builder-photo{position:relative}
.builder-avatar{width:100%;height:auto;max-width:400px;aspect-ratio:4/5;border-radius:10px;object-fit:cover;object-position:50% 28%;border:1px solid var(--border-strong);box-shadow:0 24px 60px rgba(10,22,40,0.6);margin-left:auto}
.builder-badge{position:absolute;left:0;bottom:24px;background:var(--sky);color:var(--navy-900);font-family:'Press Start 2P',monospace;font-size:9px;letter-spacing:0.1em;padding:12px 16px;border-radius:4px;line-height:1.7;box-shadow:0 10px 24px rgba(0,0,0,0.35)}
.builder h2{font-family:'Press Start 2P',monospace;font-size:clamp(1.2rem,2.4vw,1.8rem);color:var(--cream);line-height:1.4;margin:0 0 1.4rem}
.builder-body{color:var(--muted);font-size:1.05rem;line-height:1.75;margin-bottom:1rem;max-width:56ch}
.builder-body b{color:var(--text)}
.builder-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-top:1.4rem}

/* PACKAGES */
.packages{padding:var(--pad) 0;background:var(--navy-900);border-top:1px solid var(--border)}
.pkg-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;align-items:stretch}
.pkg{position:relative;background:var(--ink);border:1px solid var(--border);border-radius:10px;padding:36px 30px;display:flex;flex-direction:column}
.pkg--hot{border-color:var(--sky-light);border-width:2px;background:linear-gradient(160deg,rgba(74,168,220,0.16),var(--ink) 55%);box-shadow:0 18px 60px rgba(74,168,220,0.3);transform:scale(1.04)}
@media(max-width:960px){.pkg--hot{transform:none}}
.pkg-badge{position:absolute;top:-11px;left:50%;transform:translateX(-50%);background:var(--sky);color:var(--navy-900);font-family:'Press Start 2P',monospace;font-size:8px;letter-spacing:0.1em;text-transform:uppercase;padding:6px 12px;border-radius:999px;white-space:nowrap}
.pkg h3{font-family:'Press Start 2P',monospace;font-size:0.85rem;color:var(--sky);margin-bottom:1rem;letter-spacing:0.05em}
.pkg-price{font-family:'Press Start 2P',monospace;font-size:1.55rem;color:var(--cream);margin-bottom:0.4rem}
.pkg-period{display:block;font-family:'Inter',sans-serif;font-size:0.8rem;color:var(--muted);margin-top:8px;letter-spacing:0.02em}
.pkg-tag{color:var(--cream);font-weight:600;font-size:0.95rem;margin:1rem 0 1.2rem;padding-top:1rem;border-top:1px solid var(--border)}
.pkg .service-list{grid-template-columns:1fr;margin-bottom:1.6rem}
.pkg-cta{margin-top:auto;justify-content:center}

/* CHECKUP */
.checkup{padding:84px 0;background:linear-gradient(135deg,var(--navy-800),var(--navy-900));border-top:1px solid var(--border)}
.checkup-inner{display:grid;grid-template-columns:1.1fr 0.9fr;gap:48px;align-items:center}
.checkup-gauge{width:150px;margin-bottom:12px}
.checkup-gauge svg{width:100%;height:auto;display:block}
.kg-needle{transform-box:fill-box;transform-origin:50% 100%;animation:kgRev 3.6s cubic-bezier(0.4,0,0.3,1.3) infinite}
@keyframes kgRev{0%,12%{transform:rotate(-80deg)}42%,85%{transform:rotate(76deg)}100%{transform:rotate(-80deg)}}
@media (prefers-reduced-motion:reduce){.kg-needle{animation:none;transform:rotate(76deg)}}
.checkup h2{font-family:'Press Start 2P',monospace;font-size:clamp(1.1rem,2.2vw,1.6rem);color:var(--cream);margin-bottom:1rem;line-height:1.5}
.checkup p{color:var(--muted);line-height:1.7;max-width:520px}
.checkup-form{background:var(--ink);border:1px solid var(--border-strong);border-radius:10px;padding:28px}
.checkup-form label{display:block;font-size:0.82rem;font-weight:600;color:var(--muted);margin-bottom:14px}
.checkup-form input{width:100%;margin-top:6px;padding:12px;font:inherit;font-size:0.95rem;background:var(--navy-900);border:1px solid var(--border);border-radius:6px;color:var(--text)}
.checkup-form input::placeholder{color:#5F7890}
.checkup-form input:focus{outline:2px solid var(--sky)}
.checkup-form .btn{width:100%;justify-content:center}
.checkup-status{margin-top:10px;font-size:0.88rem;font-weight:600;text-align:center;min-height:1.2em}
.checkup-status.ok{color:#7DD3A0}
.checkup-status.err{color:#E08D79}
.hp-field{position:absolute;left:-9999px}

/* FAQ */
.faq{padding:var(--pad) 0;background:var(--ink);border-top:1px solid var(--border)}
.faq-list{max-width:780px;margin:0 auto;border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--navy-900)}
.faq-item{border-bottom:1px solid var(--border)}
.faq-item:last-child{border-bottom:none}
.faq-q{padding:22px 26px;font-weight:600;color:var(--cream);font-size:1.02rem;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;list-style:none}
.faq-q::-webkit-details-marker{display:none}
.faq-q::after{content:'+';color:var(--sky);font-family:'Press Start 2P',monospace;font-size:0.9rem;flex:none}
details[open] .faq-q::after{content:'-'}
details[open] .faq-q{background:rgba(159,212,242,0.04)}
.faq-a{padding:0 26px 22px;color:var(--muted);font-size:0.95rem;line-height:1.7}

/* CONTACT */
.cta{padding:var(--pad) 0;background:linear-gradient(135deg,var(--navy),var(--navy-900));border-top:1px solid var(--border)}
.cta-inner{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.cta h2{font-family:'Press Start 2P',monospace;font-size:clamp(1.3rem,2.6vw,2rem);color:var(--cream);line-height:1.45;margin-bottom:1.25rem}
.cta p{color:var(--sky-light);margin-bottom:1.6rem;font-size:1.05rem;line-height:1.7;max-width:52ch}
.cta-alt{font-size:0.9rem;color:var(--sky-light);opacity:0.85}
.cta-alt a{color:var(--cream);border-bottom:1px solid var(--border-strong)}
.cta-form{background:rgba(10,22,40,0.55);border:1px solid var(--border-strong);border-radius:10px;padding:28px;display:flex;flex-direction:column;gap:12px}
.cta-form label{font-size:0.82rem;color:var(--sky-light);font-weight:500;margin-bottom:2px}
.cta-form input,.cta-form textarea{background:var(--ink);border:1px solid var(--border);border-radius:4px;padding:12px 14px;color:var(--text);font-family:'Inter',sans-serif;font-size:0.95rem;transition:border-color 0.2s}
.cta-form input:focus,.cta-form textarea:focus{outline:none;border-color:var(--sky)}
.cta-form textarea{resize:vertical;min-height:90px}
.cta-form button{margin-top:8px;align-self:flex-start}
.cta-form .honeypot{display:none}

/* FOOTER */
.footer{padding:60px 0 32px;background:var(--ink);border-top:1px solid var(--border)}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1.4fr 1fr;gap:40px;margin-bottom:48px}
.footer-brand img{height:32px;margin-bottom:16px}
.footer-brand p{color:var(--muted);font-size:0.9rem;line-height:1.6;max-width:320px}
.footer-col h4{font-family:'Press Start 2P',monospace;font-size:10px;color:var(--sky);letter-spacing:0.15em;margin-bottom:1rem;text-transform:uppercase}
.footer-col a{display:block;color:var(--muted);font-size:0.9rem;padding:6px 0;transition:color 0.2s}
.footer-col a:hover{color:var(--text)}
.footer-bottom{padding-top:24px;border-top:1px solid var(--border);display:flex;justify-content:space-between;color:var(--muted);font-size:0.85rem;flex-wrap:wrap;gap:12px}

/* DETAILS (desktop open, mobile tap) */
.dt>summary{list-style:none;cursor:pointer}
.dt>summary::-webkit-details-marker{display:none}
@media(min-width:761px){.dt>summary{display:none}.footer-col>summary{display:block;cursor:default}}
.swipe{display:none}

/* RESPONSIVE */
@media(max-width:960px){
  :root{--pad:80px}
  .nav-menu a:not(.btn),.nav-menu .btn{display:none}
  .nav-burger{display:flex}
  .hero{padding:64px 0 56px}
  .hero-grid{grid-template-columns:1fr;gap:36px;text-align:center}
  .hero-ctas{justify-content:center}
  .hero-mascot{margin:0 auto;max-width:340px}
  .hero-sub,.hero-facts{margin-left:auto;margin-right:auto}
  .hero-facts{justify-content:center}
  .proof-inner{grid-template-columns:1fr;gap:12px;text-align:center}
  .proof-label{max-width:none;margin-bottom:8px}
  .work-grid,.pkg-grid{grid-template-columns:1fr}
  .receipts-grid{grid-template-columns:1fr}
  .receipt{border-right:none;border-bottom:1px solid var(--border)}
  .receipt:last-child{border-bottom:none}
  .receipts-head{flex-direction:column;align-items:flex-start;gap:8px}
  .problem-ledger{grid-template-columns:1fr}
  .problem-card{border-right:none;border-bottom:1px solid var(--border)}
  .problem-card:last-child{border-bottom:none}
  .problem-super{flex-direction:column;align-items:flex-start;gap:16px}
  .service-row{grid-template-columns:1fr;gap:28px;padding:44px 0}
  .service-row:nth-child(even) .service-viz{order:0}
  .process-timeline{grid-template-columns:repeat(2,1fr);gap:36px 24px}
  .process-timeline::before{display:none}
  .industries-grid{grid-template-columns:1fr}
  .industry-card{border-right:none;border-bottom:1px solid var(--border)}
  .industry-card:last-child{border-bottom:none}
  .case-top{grid-template-columns:1fr;padding:28px 24px}
  .case-visual{max-width:360px;margin:0 auto}
  .case-metrics{grid-template-columns:repeat(2,1fr)}
  .case-metrics > div{border-bottom:1px solid var(--border)}
  .case-metrics > div:nth-child(2n){border-right:none}
  .case-metrics > div:last-child{grid-column:1/-1;border-right:none;border-bottom:none}
  .case-charts{grid-template-columns:1fr;padding:24px}
  .builder-inner{grid-template-columns:1fr;gap:36px}
  .builder-avatar{margin:0 auto;max-width:320px}
  .builder-badge{left:50%;transform:translateX(-50%)}
  .builder{text-align:center}
  .builder-body{margin-inline:auto}
  .builder-ctas{justify-content:center}
  .checkup-inner{grid-template-columns:1fr;gap:32px}
  .cta-inner{grid-template-columns:1fr;gap:32px}
  .footer-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:760px){
  .hero{padding:44px 0 36px}
  .hero h1{font-size:1.55rem}
  .hero-sub{font-size:1rem;margin-bottom:1.6rem}
  .hero-ctas{margin-bottom:0}
  .hero-facts{display:none}
  .hero-mascot{max-width:220px}
  .hero-grid{gap:28px}
  .proof-inner{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px 12px;padding:16px 20px 18px}
  .proof-label{width:100%;text-align:center;max-width:none;margin-bottom:4px}
  .proof-logo{min-height:0;padding:0;opacity:0.9;flex:0 0 auto}
  .proof-img{height:40px}
  .proof-mark--dta{font-size:0.92rem}
  .proof-mark--wlrg{font-size:0.82rem}
  .proof-mark span{display:none}
  .section-header{margin-bottom:1.8rem}
  .section-header h2{font-size:1.15rem;line-height:1.5}
  .section-header p{font-size:0.98rem}
