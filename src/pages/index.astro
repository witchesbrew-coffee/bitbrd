<script is:inline>
(function(){
  // hero pixel stars, seeded so the field is the same every load
  var s=document.getElementById('stars');if(!s)return;
  var seed=7;function r(){seed=(seed*9301+49297)%233280;return seed/233280}
  var n=window.innerWidth<640?26:54,h='';
  for(var i=0;i<n;i++){h+='<i style="left:'+(r()*100).toFixed(2)+'%;top:'+(r()*100).toFixed(2)+'%;animation-delay:-'+(r()*9).toFixed(1)+'s"></i>'}
  s.innerHTML=h;
})();
(function(){
  var nav=document.getElementById('nav'),b=document.getElementById('burger');if(!b)return;
  b.addEventListener('click',function(){var o=nav.classList.toggle('open');b.setAttribute('aria-expanded',o?'true':'false')});
  nav.querySelectorAll('.nav-drawer a').forEach(function(a){a.addEventListener('click',function(){nav.classList.remove('open');b.setAttribute('aria-expanded','false')})});
})();
(function(){
  var f=document.getElementById('checkup-form');if(!f)return;
  var st=document.getElementById('checkup-status');var t0=Date.now();
  f.addEventListener('submit',async function(e){
    e.preventDefault();
    if(f['bot-field'].value||Date.now()-t0<3000)return;
    st.textContent='Sending…';
    try{
      var r=await fetch('/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(new FormData(f)).toString()});
      if(!r.ok)throw new Error(r.status);
      f.reset();st.textContent='✓ Got it. Your checkup is on the way.';st.className='checkup-status ok';
    }catch(err){st.textContent='Hmm, that didn\'t go through. Email hello@bitbrd.com instead.';st.className='checkup-status err';}
  });
})();
(function(){
  var mq=window.matchMedia('(max-width:760px)');
  function sync(){var m=mq.matches;document.querySelectorAll('details.dt').forEach(function(d){d.open=!m});}
  sync();mq.addEventListener?mq.addEventListener('change',sync):mq.addListener(sync);
  var g=document.getElementById('pkgGrid'),hot=g&&g.querySelector('.pkg--hot');
  if(g&&hot&&mq.matches){g.scrollLeft=hot.offsetLeft-g.offsetLeft-(g.clientWidth-hot.clientWidth)/2;}
})();
(function(){
  var rs=document.querySelectorAll('.receipt, .problem, .case-chart');
  if(!('IntersectionObserver' in window)){rs.forEach(function(r){r.classList.add('in-view')});return;}
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in-view');io.unobserve(e.target);}})},{threshold:0.25});
  rs.forEach(function(r){io.observe(r)});
})();
</script>
