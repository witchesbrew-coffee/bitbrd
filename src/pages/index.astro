.builder-body b{color:var(--text)}
.builder-cta{margin-top:0.75rem}

/* CHECKUP */
.checkup{padding:80px 0;background:linear-gradient(135deg,var(--navy-800),var(--navy-900));border-top:1px solid var(--border)}
.checkup-inner{display:grid;grid-template-columns:1.1fr 0.9fr;gap:48px;align-items:center}
.checkup h2{font-family:'Press Start 2P',monospace;font-size:clamp(1.1rem,2.2vw,1.6rem);color:var(--cream);margin-bottom:1rem;line-height:1.5}
.checkup p{color:var(--muted);line-height:1.7;max-width:520px}
.checkup-form{background:var(--ink);border:1px solid var(--border-strong);border-radius:8px;padding:28px}
.checkup-form label{display:block;font-size:0.82rem;font-weight:600;color:var(--muted);margin-bottom:14px}
.checkup-form input{width:100%;margin-top:6px;padding:12px;font:inherit;font-size:0.95rem;background:var(--navy-900);border:1px solid var(--border);border-radius:6px;color:var(--text)}
.checkup-form input:focus{outline:2px solid var(--sky)}
.checkup-form .btn{width:100%;justify-content:center}
.checkup-status{margin-top:10px;font-size:0.88rem;font-weight:600;text-align:center;min-height:1.2em}
.checkup-status.ok{color:#7DD3A0}
.checkup-status.err{color:#E08D79}
.hp-field{position:absolute;left:-9999px}

.case-charts{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:36px;padding-top:30px;border-top:1px solid var(--border)}
.case-chart{background:var(--ink);border:1px solid var(--border);border-radius:8px;padding:18px 14px 14px}
.case-chart svg{width:100%;height:auto;display:block}
.case-chart-title{font-family:'Press Start 2P',monospace;font-size:9px;color:var(--sky);letter-spacing:0.06em;margin-top:10px;text-transform:uppercase}
.case-chart-cap{font-size:0.8rem;color:var(--muted);margin-top:6px;line-height:1.5}
/* CONVEYOR CARDS + FOURTH OPTION */
.problem-card{opacity:0;transform:translateX(-64px);transition:opacity 0.7s cubic-bezier(0.22,1,0.36,1),transform 0.7s cubic-bezier(0.22,1,0.36,1)}
.problem.in-view .problem-card:nth-child(1){opacity:1;transform:none;transition-delay:0.1s}
.problem.in-view .problem-card:nth-child(2){opacity:1;transform:none;transition-delay:0.32s}
.problem.in-view .problem-card:nth-child(3){opacity:1;transform:none;transition-delay:0.54s}
.problem-super{display:flex;align-items:center;gap:28px;margin-top:32px;padding:34px 36px;background:linear-gradient(135deg,rgba(74,168,220,0.14),rgba(15,63,122,0.35));border:1.5px solid var(--sky);border-radius:8px;box-shadow:0 0 34px rgba(74,168,220,0.22),inset 0 0 24px rgba(74,168,220,0.06);opacity:0;transform:translateX(72px);transition:opacity 0.7s cubic-bezier(0.22,1,0.36,1) 0.95s,transform 0.7s cubic-bezier(0.22,1,0.36,1) 0.95s}
.problem.in-view .problem-super{opacity:1;transform:none}
.problem-super-num{font-family:'Press Start 2P',monospace;font-size:1.6rem;color:var(--sky);text-shadow:0 0 16px rgba(74,168,220,0.7);flex:none}
.problem-super h3{font-family:'Press Start 2P',monospace;font-size:1rem;color:var(--cream);margin-bottom:0.6rem;line-height:1.5}
.problem-super p{color:var(--text);font-size:0.97rem;line-height:1.7;max-width:62ch}
.problem-super-cta{flex:none;white-space:nowrap}
@media (prefers-reduced-motion:reduce){.problem-card,.problem-super{opacity:1;transform:none;transition:none}}
@media (max-width:760px){.problem-super{flex-direction:column;align-items:flex-start;gap:16px}}

/* PIXEL CITYSCAPE FOOTER */
.cityscape{background:var(--ink);line-height:0;margin-bottom:-1px}
.cityscape-svg{width:100%;height:auto;display:block;max-height:170px}
.cw{opacity:0.25}
.cw0{animation:twinkA 5s steps(1) infinite}
.cw1{animation:twinkB 7s steps(1) infinite}
.cw2{animation:twinkC 9s steps(1) infinite}
@keyframes twinkA{0%,60%{opacity:0.7}61%,82%{opacity:0.15}83%,100%{opacity:0.7}}
@keyframes twinkB{0%,40%{opacity:0.25}41%,70%{opacity:0.85}71%,100%{opacity:0.25}}
@keyframes twinkC{0%,25%{opacity:0.5}26%,50%{opacity:0.1}51%,100%{opacity:0.5}}
@media (prefers-reduced-motion:reduce){.cw{animation:none;opacity:0.5}}

@media(max-width:960px){
