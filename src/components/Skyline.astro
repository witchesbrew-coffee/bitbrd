<style is:global>
/* PIXEL CITYSCAPE FOOTER */
.cityscape{background:var(--ink);line-height:0;margin-bottom:-1px}
.cityscape-svg{width:100%;height:auto;display:block}
/* Mobile: render the city large and pan across it slowly, back and forth (TV-screensaver style) */
@media (max-width:760px){
  .cityscape--pan{overflow:hidden}
  .cityscape--pan .cityscape-svg{width:340%;animation:cityPan 80s ease-in-out infinite alternate}
}
@keyframes cityPan{0%,3%{transform:translateX(0)}97%,100%{transform:translateX(-70.6%)}}
@media (prefers-reduced-motion:reduce){.cityscape--pan .cityscape-svg{width:100%;animation:none}}
.clouds{animation:cloudDrift 320s linear infinite}
@keyframes cloudDrift{to{transform:translateX(-1440px)}}
@media (prefers-reduced-motion:reduce){.clouds{animation:none}}
.cw{opacity:0.25}
.cw0{animation:twinkA 5s steps(1) infinite}
.cw1{animation:twinkB 7s steps(1) infinite}
.cw2{animation:twinkC 9s steps(1) infinite}
@keyframes twinkA{0%,60%{opacity:0.7}61%,82%{opacity:0.15}83%,100%{opacity:0.7}}
@keyframes twinkB{0%,40%{opacity:0.25}41%,70%{opacity:0.85}71%,100%{opacity:0.25}}
@keyframes twinkC{0%,25%{opacity:0.5}26%,50%{opacity:0.1}51%,100%{opacity:0.5}}
@media (prefers-reduced-motion:reduce){.cw{animation:none;opacity:0.5}}
.lw{opacity:0;animation-timing-function:steps(1);animation-iteration-count:infinite}
.lw0{animation-name:lightsA}.lw1{animation-name:lightsB}.lw2{animation-name:lightsC}
@keyframes lightsA{0%,33%{opacity:0}34%,100%{opacity:0.85}}
@keyframes lightsB{0%,42%{opacity:0.75}43%,70%{opacity:0}71%,100%{opacity:0.75}}
@keyframes lightsC{0%,38%{opacity:0}39%,88%{opacity:0.9}89%,100%{opacity:0}}
@media (prefers-reduced-motion:reduce){.lw{animation:none;opacity:0.4}}

